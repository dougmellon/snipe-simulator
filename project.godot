; Engine configuration file.

config_version=5

[application]

config/name="Snipe Sim: Union Reservoir"
config/description="Snipe dinghy racing on Union Reservoir, Longmont, Colorado, under the Union Sailing Club sailing instructions."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
run/max_fps=240

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=16

[rendering]

rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/msaa_3d=2
